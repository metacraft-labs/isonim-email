# EditorConfig file: http://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = unset

# .envrc keeps the canonical flake-overrides snippet byte-identical to the
# sibling repos, which indent continuations with tabs.
[.envrc]
indent_style = tab
indent_size = 4

# Nim: 2-space indents are the canonical style, but multi-line proc signatures
# align continuation lines with the column after the opening `(`, which is
# rarely on an even column. Let nimpretty own the column math instead of
# editorconfig-checker.
[*.nim]
indent_size = unset

[{Makefile,*.go,.gitmodules}]
indent_style = tab
indent_size = 4
